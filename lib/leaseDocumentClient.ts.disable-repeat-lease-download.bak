import { router } from "expo-router";
import ReactNativeBlobUtil from "react-native-blob-util";
import { Platform } from "react-native";

const PDF_MIME_TYPE = "application/pdf";
const PREVIEW_ROUTE = "/lease-viewer";

const APPWRITE_ENDPOINT =
  process.env.EXPO_PUBLIC_APPWRITE_ENDPOINT?.trim() || "";

const APPWRITE_PROJECT_ID =
  process.env.EXPO_PUBLIC_APPWRITE_PROJECT_ID?.trim() || "";

const LEASE_BUCKET_ID =
  process.env.EXPO_PUBLIC_APPWRITE_LEASE_BUCKET_ID?.trim() ||
  process.env.EXPO_PUBLIC_APPWRITE_BUCKET_ID?.trim() ||
  "";

interface DirectLeaseAccess {
  requestId: string;
  documentId: string;
  documentName: string;
  viewUrl: string;
  downloadUrl: string;
}

const sanitizeFileName = (value: string): string => {
  const cleaned = value
    .trim()
    .replace(/[<>:"/\\|?*\u0000-\u001F]/g, "_")
    .replace(/\s+/g, " ");

  return cleaned.toLowerCase().endsWith(".pdf")
    ? cleaned
    : `${cleaned || "lease_document"}.pdf`;
};

const sanitizePathSegment = (value: string): string =>
  value
    .trim()
    .replace(/[^a-zA-Z0-9_-]/g, "_")
    .slice(0, 80) || "lease";

const toFileUri = (filePath: string): string => {
  if (
    filePath.startsWith("file://") ||
    filePath.startsWith("content://")
  ) {
    return filePath;
  }

  return `file://${filePath}`;
};

const removeFileIfPresent = async (filePath: string): Promise<void> => {
  try {
    if (await ReactNativeBlobUtil.fs.exists(filePath)) {
      await ReactNativeBlobUtil.fs.unlink(filePath);
    }
  } catch (error) {
    console.warn("Could not remove an older lease file:", error);
  }
};

const requireLeaseStorageConfig = (): void => {
  if (!APPWRITE_ENDPOINT) {
    throw new Error("The Appwrite endpoint is missing.");
  }

  if (!APPWRITE_PROJECT_ID) {
    throw new Error("The Appwrite project ID is missing.");
  }

  if (!LEASE_BUCKET_ID) {
    throw new Error("The lease storage bucket is missing.");
  }
};

const getDirectLeaseAccess = (
  requestId: string,
  documentId: string,
  requestedFileName = "lease_document.pdf",
): DirectLeaseAccess => {
  const normalizedRequestId = requestId.trim();
  const normalizedDocumentId = documentId.trim();

  if (!normalizedRequestId) {
    throw new Error("The lease request ID is missing.");
  }

  if (!normalizedDocumentId) {
    throw new Error("The lease document ID is missing.");
  }

  requireLeaseStorageConfig();

  const endpoint = APPWRITE_ENDPOINT.replace(/\/+$/, "");
  const baseUrl =
    `${endpoint}/storage/buckets/${encodeURIComponent(LEASE_BUCKET_ID)}` +
    `/files/${encodeURIComponent(normalizedDocumentId)}`;

  const query = `?project=${encodeURIComponent(APPWRITE_PROJECT_ID)}`;

  return {
    requestId: normalizedRequestId,
    documentId: normalizedDocumentId,
    documentName: sanitizeFileName(requestedFileName),
    viewUrl: `${baseUrl}/view${query}`,
    downloadUrl: `${baseUrl}/download${query}`,
  };
};

const downloadLeaseToPreviewCache = async (
  downloadUrl: string,
  documentId: string,
): Promise<string> => {
  const cacheDirectory = ReactNativeBlobUtil.fs.dirs.CacheDir;

  if (!cacheDirectory) {
    throw new Error("The device cache directory is unavailable.");
  }

  const destinationPath =
    `${cacheDirectory}/nookly_lease_preview_` +
    `${sanitizePathSegment(documentId)}.pdf`;

  const existing = await ReactNativeBlobUtil.fs.exists(destinationPath);

  if (existing) {
    const stat = await ReactNativeBlobUtil.fs.stat(destinationPath);

    if (Number(stat.size || 0) > 0) {
      return toFileUri(destinationPath);
    }

    await removeFileIfPresent(destinationPath);
  }

  const response = await ReactNativeBlobUtil.config({
    fileCache: true,
    path: destinationPath,
  }).fetch("GET", downloadUrl, {
    Accept: PDF_MIME_TYPE,
  });

  const status = Number(response.info().status || 0);

  if (status < 200 || status >= 300) {
    await removeFileIfPresent(destinationPath);

    throw new Error(
      `The lease preview failed with HTTP ${status || "unknown"}.`,
    );
  }

  const downloadedPath = response.path();

  if (!(await ReactNativeBlobUtil.fs.exists(downloadedPath))) {
    throw new Error("The lease was downloaded, but its local file is missing.");
  }

  return toFileUri(downloadedPath);
};

const saveAndroidLeaseToDownloads = async (
  downloadUrl: string,
  fileName: string,
): Promise<void> => {
  const androidVersion = Number(Platform.Version);

  if (androidVersion >= 29) {
    const response = await ReactNativeBlobUtil.config({
      fileCache: true,
      appendExt: "pdf",
    }).fetch("GET", downloadUrl, {
      Accept: PDF_MIME_TYPE,
    });

    const status = Number(response.info().status || 0);

    if (status < 200 || status >= 300) {
      await removeFileIfPresent(response.path());

      throw new Error(
        `The lease download failed with HTTP ${status || "unknown"}.`,
      );
    }

    const temporaryPath = response.path();

    try {
      const savedUri =
        await ReactNativeBlobUtil.MediaCollection.copyToMediaStore(
          {
            name: fileName,
            parentFolder: "",
            mimeType: PDF_MIME_TYPE,
          },
          "Download",
          temporaryPath,
        );

      if (!savedUri) {
        throw new Error(
          "Android did not return a saved Downloads location.",
        );
      }
    } finally {
      await removeFileIfPresent(temporaryPath);
    }

    return;
  }

  const downloadDirectory = ReactNativeBlobUtil.fs.dirs.DownloadDir;

  if (!downloadDirectory) {
    throw new Error("The Android Downloads folder is unavailable.");
  }

  const destinationPath = `${downloadDirectory}/${fileName}`;

  await removeFileIfPresent(destinationPath);

  const response = await ReactNativeBlobUtil.config({
    addAndroidDownloads: {
      useDownloadManager: true,
      notification: true,
      title: fileName,
      description: "Nookly lease document",
      mime: PDF_MIME_TYPE,
      mediaScannable: true,
      path: destinationPath,
    },
  }).fetch("GET", downloadUrl, {
    Accept: PDF_MIME_TYPE,
  });

  const status = Number(response.info().status || 0);

  if (status < 200 || status >= 300) {
    throw new Error(
      `The lease download failed with HTTP ${status || "unknown"}.`,
    );
  }
};

const saveIosLeaseToDocuments = async (
  downloadUrl: string,
  fileName: string,
): Promise<void> => {
  const documentsDirectory = ReactNativeBlobUtil.fs.dirs.DocumentDir;

  if (!documentsDirectory) {
    throw new Error("The device documents directory is unavailable.");
  }

  const destinationPath = `${documentsDirectory}/${fileName}`;

  await removeFileIfPresent(destinationPath);

  const response = await ReactNativeBlobUtil.config({
    fileCache: true,
    path: destinationPath,
  }).fetch("GET", downloadUrl, {
    Accept: PDF_MIME_TYPE,
  });

  const status = Number(response.info().status || 0);

  if (status < 200 || status >= 300) {
    await removeFileIfPresent(destinationPath);

    throw new Error(
      `The lease download failed with HTTP ${status || "unknown"}.`,
    );
  }
};

export const formatLeaseFileSize = (bytes?: number): string => {
  if (!bytes || bytes <= 0) return "PDF document";

  if (bytes < 1024) return `${bytes} B`;

  const kilobytes = bytes / 1024;

  if (kilobytes < 1024) {
    return `${kilobytes.toFixed(kilobytes >= 100 ? 0 : 1)} KB`;
  }

  const megabytes = kilobytes / 1024;

  return `${megabytes.toFixed(megabytes >= 10 ? 1 : 2)} MB`;
};

export const previewLeaseDocument = async (
  requestId: string,
  documentId: string,
  requestedFileName = "lease_document.pdf",
): Promise<void> => {
  const access = getDirectLeaseAccess(
    requestId,
    documentId,
    requestedFileName,
  );

  const localUri = await downloadLeaseToPreviewCache(
    access.downloadUrl,
    access.documentId,
  );

  router.push({
    pathname: PREVIEW_ROUTE,
    params: {
      uri: localUri,
      name: access.documentName,
      requestId: access.requestId,
      documentId: access.documentId,
    },
  } as never);
};

export const downloadLeaseDocument = async (
  requestId: string,
  documentId: string,
  requestedFileName: string,
): Promise<void> => {
  const access = getDirectLeaseAccess(
    requestId,
    documentId,
    requestedFileName,
  );

  if (Platform.OS === "android") {
    await saveAndroidLeaseToDownloads(
      access.downloadUrl,
      access.documentName,
    );
    return;
  }

  if (Platform.OS === "ios") {
    await saveIosLeaseToDocuments(
      access.downloadUrl,
      access.documentName,
    );
    return;
  }

  throw new Error("Lease downloads are only supported on Android and iOS.");
};
