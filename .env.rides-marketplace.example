# MOBILE APP
# Add this line to the existing mobile .env file.
EXPO_PUBLIC_APPWRITE_RIDES_MARKETPLACE_FUNCTION_ID=rides-marketplace-api

# APPWRITE FUNCTION: rides-marketplace-api
# Add these as Function variables in the Appwrite Console.
APPWRITE_DATABASE_ID=
APPWRITE_USERS_COLLECTION_ID=
APPWRITE_ORGANIZATIONS_COLLECTION_ID=

# Recommended for the current single-institution test deployment.
# Use the Appwrite organization document ID that monitors the student's ride.
# The Function first tries to match user.schoolLocation to an organization name,
# then uses this value as the fallback.
APPWRITE_RIDES_DEFAULT_ORGANIZATION_ID=

# Optional behaviour settings.
APPWRITE_RIDES_REQUEST_EXPIRY_HOURS=12
APPWRITE_RIDES_OFFER_EXPIRY_MINUTES=45

# Optional table overrides.
# The Function already uses the verified live IDs below as defaults.
APPWRITE_RIDE_DRIVERS_TABLE_ID=ride_drivers
APPWRITE_RIDE_VEHICLES_TABLE_ID=ride_vehicles
APPWRITE_RIDE_REQUESTS_TABLE_ID=ride_requests
APPWRITE_RIDE_OFFERS_TABLE_ID=ride_offers
APPWRITE_RIDE_DRIVER_INSTITUTIONS_TABLE_ID=ride_driver_institutions
APPWRITE_RIDES_TABLE_ID=rides
APPWRITE_RIDE_BOOKINGS_TABLE_ID=ride_bookings
APPWRITE_RIDE_TRIP_CORE_TABLE_ID=ride_trip_core
APPWRITE_RIDE_TRIP_WAYPOINTS_TABLE_ID=ride_trip_waypoints
APPWRITE_RIDE_EXPECTED_ROUTE_POINTS_TABLE_ID=ride_expected_route_points
APPWRITE_RIDE_EVENTS_TABLE_ID=ride_events

# Never put APPWRITE_API_KEY in the mobile .env file.
# The Function uses Appwrite's dynamic execution key.
