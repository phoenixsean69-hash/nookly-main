import { Colors } from "@/constants/Colors";
import {
  formatDriverRideStatus,
  getDriverDashboard,
  getDriverRideDetails,
  reportDriverIncident,
  sendDriverLocation,
  updateDriverRideStatus,
} from "@/services/driver.service";
import type {
  DriverDashboard,
  DriverRide,
  DriverRideDetails,
  DriverRideStatus,
} from "@/types/driver";
import { Ionicons } from "@expo/vector-icons";
import NetInfo from "@react-native-community/netinfo";
import { useBottomTabBarHeight } from "@react-navigation/bottom-tabs";
import * as Location from "expo-location";
import { router, useFocusEffect } from "expo-router";
import React, {
  useCallback,
  useEffect,
  useMemo,
  useRef,
  useState,
} from "react";
import {
  ActivityIndicator,
  Alert,
  KeyboardAvoidingView,
  Linking,
  Modal,
  Platform,
  RefreshControl,
  ScrollView,
  Text,
  TextInput,
  TouchableOpacity,
  View,
  useColorScheme,
} from "react-native";
import {
  SafeAreaView,
  useSafeAreaInsets,
} from "react-native-safe-area-context";
import { WebView } from "react-native-webview";

interface MapCoordinate {
  latitude: number;
  longitude: number;
  label: string;
  kind: "origin" | "stop" | "destination";
}

interface DriverCoordinate {
  latitude: number;
  longitude: number;
  heading: number | null;
  speedKph: number | null;
  accuracyMeters: number | null;
}

type LocationPermissionState = "unknown" | "granted" | "denied";
type IncidentPriority = "low" | "medium" | "high" | "critical";

const INCIDENT_CATEGORIES = [
  { value: "breakdown", label: "Breakdown", icon: "build-outline" },
  { value: "accident", label: "Accident", icon: "warning-outline" },
  { value: "medical", label: "Medical", icon: "medkit-outline" },
  { value: "security", label: "Security", icon: "shield-outline" },
  { value: "passenger", label: "Passenger", icon: "people-outline" },
  { value: "other", label: "Other", icon: "ellipsis-horizontal" },
] as const;

const INCIDENT_PRIORITIES: IncidentPriority[] = [
  "low",
  "medium",
  "high",
  "critical",
];

const isFiniteCoordinate = (
  latitude: unknown,
  longitude: unknown,
): boolean =>
  typeof latitude === "number" &&
  Number.isFinite(latitude) &&
  typeof longitude === "number" &&
  Number.isFinite(longitude) &&
  Math.abs(latitude) <= 90 &&
  Math.abs(longitude) <= 180;

const toRadians = (degrees: number): number =>
  (degrees * Math.PI) / 180;

const haversineDistanceKm = (
  from: Pick<DriverCoordinate, "latitude" | "longitude">,
  to: Pick<MapCoordinate, "latitude" | "longitude">,
): number => {
  const earthRadiusKm = 6371;
  const latitudeDelta = toRadians(to.latitude - from.latitude);
  const longitudeDelta = toRadians(to.longitude - from.longitude);
  const fromLatitude = toRadians(from.latitude);
  const toLatitude = toRadians(to.latitude);

  const a =
    Math.sin(latitudeDelta / 2) ** 2 +
    Math.cos(fromLatitude) *
      Math.cos(toLatitude) *
      Math.sin(longitudeDelta / 2) ** 2;

  return earthRadiusKm * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
};

const formatLocationAge = (value: string | null): string => {
  if (!value) return "Waiting for first update";

  const timestamp = new Date(value).getTime();

  if (!Number.isFinite(timestamp)) return "Updated recently";

  const seconds = Math.max(0, Math.floor((Date.now() - timestamp) / 1000));

  if (seconds < 15) return "Updated just now";
  if (seconds < 60) return `Updated ${seconds}s ago`;

  const minutes = Math.floor(seconds / 60);

  if (minutes < 60) return `Updated ${minutes}m ago`;

  return `Updated at ${new Date(value).toLocaleTimeString([], {
    hour: "2-digit",
    minute: "2-digit",
  })}`;
};

const buildMapHtml = ({
  routeCoordinates,
  initialDriverCoordinate,
  primaryColor,
  surfaceColor,
  textColor,
}: {
  routeCoordinates: MapCoordinate[];
  initialDriverCoordinate: DriverCoordinate | null;
  primaryColor: string;
  surfaceColor: string;
  textColor: string;
}): string => {
  const routeJson = JSON.stringify(routeCoordinates);
  const driverJson = JSON.stringify(initialDriverCoordinate);

  return `<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style>
    html, body, #map { height: 100%; width: 100%; margin: 0; padding: 0; background: ${surfaceColor}; }
    body { overflow: hidden; }
    .leaflet-control-attribution { font-size: 9px; }
    .driver-icon { background: transparent; border: 0; }
    .driver-pin {
      width: 38px;
      height: 38px;
      border-radius: 19px;
      border: 3px solid #ffffff;
      background: ${primaryColor};
      box-shadow: 0 4px 14px rgba(0,0,0,.28);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      font-size: 18px;
      line-height: 38px;
    }
    .driver-arrow {
      display: block;
      transform-origin: center;
      font-size: 17px;
      line-height: 1;
    }
    .route-tooltip {
      color: ${textColor};
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 12px;
      font-weight: 600;
    }
  </style>
</head>
<body>
  <div id="map"></div>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    const route = ${routeJson};
    const initialDriver = ${driverJson};
    const map = L.map('map', { zoomControl: true, attributionControl: true });
    let driverMarker = null;

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    function escapeHtml(value) {
      return String(value || '').replace(/[&<>"']/g, function (character) {
        return ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#039;'
        })[character];
      });
    }

    function markerStyle(kind) {
      if (kind === 'origin') {
        return { color: '#15803D', fillColor: '#22C55E', radius: 8 };
      }

      if (kind === 'destination') {
        return { color: '#B91C1C', fillColor: '#EF4444', radius: 8 };
      }

      return { color: '#1D4ED8', fillColor: '#3B82F6', radius: 6 };
    }

    const routeLatLngs = route.map(function (point) {
      const style = markerStyle(point.kind);
      const marker = L.circleMarker([point.latitude, point.longitude], {
        radius: style.radius,
        color: style.color,
        weight: 2,
        fillColor: style.fillColor,
        fillOpacity: 1
      }).addTo(map);

      marker.bindTooltip(
        '<span class="route-tooltip">' + escapeHtml(point.label) + '</span>',
        { direction: 'top', offset: [0, -7], opacity: 0.95 }
      );

      return [point.latitude, point.longitude];
    });

    if (routeLatLngs.length > 1) {
      L.polyline(routeLatLngs, {
        color: '${primaryColor}',
        weight: 5,
        opacity: 0.82,
        lineJoin: 'round'
      }).addTo(map);
    }

    function driverIcon(heading) {
      const rotation = Number.isFinite(Number(heading)) ? Number(heading) : 0;

      return L.divIcon({
        className: 'driver-icon',
        html:
          '<div class="driver-pin"><span class="driver-arrow" style="transform: rotate(' +
          rotation +
          'deg)">▲</span></div>',
        iconSize: [38, 38],
        iconAnchor: [19, 19]
      });
    }

    window.updateDriver = function (latitude, longitude, heading) {
      const lat = Number(latitude);
      const lng = Number(longitude);

      if (!Number.isFinite(lat) || !Number.isFinite(lng)) return;

      if (!driverMarker) {
        driverMarker = L.marker([lat, lng], {
          icon: driverIcon(heading),
          zIndexOffset: 1000
        }).addTo(map);
      } else {
        driverMarker.setLatLng([lat, lng]);
        driverMarker.setIcon(driverIcon(heading));
      }
    };

    window.focusDriver = function () {
      if (driverMarker) {
        map.flyTo(driverMarker.getLatLng(), Math.max(map.getZoom(), 16), {
          animate: true,
          duration: 0.6
        });
      }
    };

    if (initialDriver) {
      window.updateDriver(
        initialDriver.latitude,
        initialDriver.longitude,
        initialDriver.heading
      );
    }

    const fitPoints = routeLatLngs.slice();

    if (initialDriver) {
      fitPoints.push([initialDriver.latitude, initialDriver.longitude]);
    }

    if (fitPoints.length > 1) {
      map.fitBounds(fitPoints, { padding: [35, 35], maxZoom: 15 });
    } else if (fitPoints.length === 1) {
      map.setView(fitPoints[0], 15);
    } else {
      map.setView([-17.8292, 31.0522], 12);
    }

    setTimeout(function () {
      map.invalidateSize();
      if (window.ReactNativeWebView) {
        window.ReactNativeWebView.postMessage('map-ready');
      }
    }, 150);
  </script>
</body>
</html>`;
};

export default function DriverActiveRideScreen() {
  const colorScheme = useColorScheme();
  const theme = Colors[colorScheme ?? "light"];
  const safeAreaInsets = useSafeAreaInsets();
  const tabBarHeight = useBottomTabBarHeight();

  const [dashboard, setDashboard] = useState<DriverDashboard | null>(null);
  const [rideDetails, setRideDetails] = useState<DriverRideDetails | null>(
    null,
  );
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [statusLoading, setStatusLoading] = useState(false);
  const [sharingLocation, setSharingLocation] = useState(false);
  const [lastLocationAt, setLastLocationAt] = useState<string | null>(null);
  const [driverCoordinate, setDriverCoordinate] =
    useState<DriverCoordinate | null>(null);
  const [locationPermission, setLocationPermission] =
    useState<LocationPermissionState>("unknown");
  const [locationMessage, setLocationMessage] = useState("");
  const [isConnected, setIsConnected] = useState(true);
  const [mapReady, setMapReady] = useState(false);
  const [mapError, setMapError] = useState("");

  const [incidentVisible, setIncidentVisible] = useState(false);
  const [incidentCategory, setIncidentCategory] = useState("breakdown");
  const [incidentPriority, setIncidentPriority] =
    useState<IncidentPriority>("medium");
  const [incidentDescription, setIncidentDescription] = useState("");
  const [incidentSubmitting, setIncidentSubmitting] = useState(false);

  const locationSubscription = useRef<Location.LocationSubscription | null>(
    null,
  );
  const mapWebView = useRef<WebView>(null);

  const bottomClearance =
    Math.max(tabBarHeight, 82) + safeAreaInsets.bottom + 28;

  const activeRide = dashboard?.activeRide ?? null;
  const detailedRide: DriverRide | DriverRideDetails | null =
    rideDetails ?? activeRide;

  const loadDashboard = useCallback(async (showLoader = true) => {
    if (showLoader) setLoading(true);

    try {
      const nextDashboard = await getDriverDashboard();
      setDashboard(nextDashboard);

      if (nextDashboard.activeRide) {
        try {
          const details = await getDriverRideDetails(
            nextDashboard.activeRide.$id,
          );
          setRideDetails(details);
        } catch (detailsError) {
          console.warn("Could not load active ride details:", detailsError);
          setRideDetails(null);
        }

        const latitude = nextDashboard.activeRide.currentLatitude;
        const longitude = nextDashboard.activeRide.currentLongitude;

        if (isFiniteCoordinate(latitude, longitude)) {
          setDriverCoordinate({
            latitude: Number(latitude),
            longitude: Number(longitude),
            heading: nextDashboard.activeRide.currentHeading ?? null,
            speedKph: nextDashboard.activeRide.currentSpeedKph ?? null,
            accuracyMeters:
              nextDashboard.activeRide.currentAccuracyMeters ?? null,
          });
          setLastLocationAt(nextDashboard.activeRide.lastLocationAt ?? null);
        }
      } else {
        setRideDetails(null);
        setDriverCoordinate(null);
        setLastLocationAt(null);
      }
    } catch (caughtError) {
      Alert.alert(
        "Could not load ride",
        caughtError instanceof Error
          ? caughtError.message
          : "Please try again.",
      );
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, []);

  useEffect(() => {
    const unsubscribe = NetInfo.addEventListener((state) => {
      setIsConnected(Boolean(state.isConnected));
    });

    void Location.getForegroundPermissionsAsync().then((permission) => {
      setLocationPermission(
        permission.status === "granted" ? "granted" : "denied",
      );
    });

    return unsubscribe;
  }, []);

  useFocusEffect(
    useCallback(() => {
      void loadDashboard();

      return () => {
        locationSubscription.current?.remove();
        locationSubscription.current = null;
        setSharingLocation(false);
      };
    }, [loadDashboard]),
  );

  const routeCoordinates = useMemo<MapCoordinate[]>(() => {
    const route = detailedRide?.route;

    if (!route) return [];

    const points: MapCoordinate[] = [];

    if (
      isFiniteCoordinate(route.originLatitude, route.originLongitude)
    ) {
      points.push({
        latitude: route.originLatitude,
        longitude: route.originLongitude,
        label: route.originName || "Origin",
        kind: "origin",
      });
    }

    const stops = [...(rideDetails?.stops ?? [])]
      .filter((stop) => isFiniteCoordinate(stop.latitude, stop.longitude))
      .sort((first, second) => first.stopOrder - second.stopOrder);

    stops.forEach((stop) => {
      points.push({
        latitude: stop.latitude,
        longitude: stop.longitude,
        label: stop.name,
        kind: "stop",
      });
    });

    if (
      isFiniteCoordinate(
        route.destinationLatitude,
        route.destinationLongitude,
      )
    ) {
      points.push({
        latitude: route.destinationLatitude,
        longitude: route.destinationLongitude,
        label: route.destinationName || "Destination",
        kind: "destination",
      });
    }

    return points;
  }, [detailedRide?.route, rideDetails?.stops]);

  const initialDriverCoordinate = useMemo<DriverCoordinate | null>(() => {
    const latitude = detailedRide?.currentLatitude;
    const longitude = detailedRide?.currentLongitude;

    if (!isFiniteCoordinate(latitude, longitude)) return null;

    return {
      latitude: Number(latitude),
      longitude: Number(longitude),
      heading: detailedRide?.currentHeading ?? null,
      speedKph: detailedRide?.currentSpeedKph ?? null,
      accuracyMeters: detailedRide?.currentAccuracyMeters ?? null,
    };
  }, [detailedRide]);

  const mapHtml = useMemo(
    () =>
      buildMapHtml({
        routeCoordinates,
        initialDriverCoordinate,
        primaryColor: theme.primary[300],
        surfaceColor: theme.surface,
        textColor: theme.text,
      }),
    [
      initialDriverCoordinate,
      routeCoordinates,
      theme.primary,
      theme.surface,
      theme.text,
    ],
  );

  useEffect(() => {
    if (!mapReady || !driverCoordinate) return;

    mapWebView.current?.injectJavaScript(`
      window.updateDriver(
        ${driverCoordinate.latitude},
        ${driverCoordinate.longitude},
        ${driverCoordinate.heading ?? 0}
      );
      true;
    `);
  }, [driverCoordinate, mapReady]);

  const destination = useMemo(
    () =>
      [...routeCoordinates]
        .reverse()
        .find((point) => point.kind === "destination") ?? null,
    [routeCoordinates],
  );

  const remainingDistanceKm = useMemo(() => {
    if (driverCoordinate && destination) {
      return haversineDistanceKm(driverCoordinate, destination);
    }

    return detailedRide?.route?.estimatedDistanceKm ?? null;
  }, [destination, detailedRide?.route, driverCoordinate]);

  const remainingMinutes = useMemo(() => {
    if (remainingDistanceKm === null) return null;

    const speedKph = driverCoordinate?.speedKph ?? 0;

    if (speedKph >= 5) {
      return Math.max(1, Math.round((remainingDistanceKm / speedKph) * 60));
    }

    const routeDistance = detailedRide?.route?.estimatedDistanceKm ?? 0;
    const routeDuration = detailedRide?.route?.estimatedDurationMinutes ?? 0;

    if (routeDistance > 0 && routeDuration > 0) {
      return Math.max(
        1,
        Math.round(routeDuration * (remainingDistanceKm / routeDistance)),
      );
    }

    return routeDuration || null;
  }, [detailedRide?.route, driverCoordinate?.speedKph, remainingDistanceKm]);

  const publishPosition = useCallback(
    async (rideId: string, position: Location.LocationObject) => {
      const nextCoordinate: DriverCoordinate = {
        latitude: position.coords.latitude,
        longitude: position.coords.longitude,
        heading: position.coords.heading,
        speedKph:
          position.coords.speed !== null && position.coords.speed >= 0
            ? position.coords.speed * 3.6
            : null,
        accuracyMeters: position.coords.accuracy,
      };

      setDriverCoordinate(nextCoordinate);
      setLastLocationAt(new Date(position.timestamp).toISOString());
      setLocationMessage("");

      if (!isConnected) {
        setLocationMessage(
          "Your position is updating on this device and will publish when the connection returns.",
        );
        return;
      }

      try {
        await sendDriverLocation(rideId, {
          ...nextCoordinate,
          isMocked: position.mocked,
        });
      } catch (caughtError) {
        console.warn("Could not publish driver location:", caughtError);
        setLocationMessage(
          "Nookly could not publish the latest position. Tracking will retry automatically.",
        );
      }
    },
    [isConnected],
  );

  const startLocationSharing = useCallback(
    async (rideId?: string) => {
      const resolvedRideId = rideId ?? activeRide?.$id;

      if (!resolvedRideId || sharingLocation) return;

      const permission = await Location.requestForegroundPermissionsAsync();

      if (permission.status !== "granted") {
        setLocationPermission("denied");
        Alert.alert(
          "Location permission required",
          "Nookly needs location access while this screen is active so passengers can follow the ride.",
        );
        return;
      }

      setLocationPermission("granted");
      setLocationMessage("");
      setSharingLocation(true);

      try {
        const currentPosition = await Location.getCurrentPositionAsync({
          accuracy: Location.Accuracy.High,
        });

        await publishPosition(resolvedRideId, currentPosition);

        locationSubscription.current?.remove();
        locationSubscription.current = await Location.watchPositionAsync(
          {
            accuracy: Location.Accuracy.High,
            timeInterval: 10_000,
            distanceInterval: 10,
          },
          (position) => {
            void publishPosition(resolvedRideId, position);
          },
        );
      } catch (caughtError) {
        setSharingLocation(false);
        setLocationMessage("");
        Alert.alert(
          "Location sharing failed",
          caughtError instanceof Error
            ? caughtError.message
            : "Please try again.",
        );
      }
    }, [activeRide?.$id, publishPosition, sharingLocation]);

  const stopLocationSharing = useCallback(() => {
    locationSubscription.current?.remove();
    locationSubscription.current = null;
    setSharingLocation(false);
    setLocationMessage("");
  }, []);

  const changeStatus = async (status: DriverRideStatus) => {
    if (!activeRide || statusLoading) return;

    const confirmed = await new Promise<boolean>((resolve) => {
      Alert.alert(
        "Update ride status",
        `Change this ride to ${formatDriverRideStatus(status)}?`,
        [
          { text: "Cancel", style: "cancel", onPress: () => resolve(false) },
          { text: "Continue", onPress: () => resolve(true) },
        ],
      );
    });

    if (!confirmed) return;

    setStatusLoading(true);

    try {
      const updatedRide = await updateDriverRideStatus(activeRide.$id, status);

      if (["completed", "cancelled"].includes(updatedRide.status)) {
        stopLocationSharing();
        setDashboard((current) =>
          current ? { ...current, activeRide: null } : current,
        );
        setRideDetails(null);
        return;
      }

      setDashboard((current) =>
        current
          ? {
              ...current,
              activeRide: current.activeRide
                ? { ...current.activeRide, ...updatedRide }
                : updatedRide,
            }
          : current,
      );

      setRideDetails((current) =>
        current ? { ...current, ...updatedRide } : current,
      );

      if (updatedRide.status === "active" && !sharingLocation) {
        void startLocationSharing(updatedRide.$id);
      }
    } catch (caughtError) {
      Alert.alert(
        "Status update failed",
        caughtError instanceof Error
          ? caughtError.message
          : "Please try again.",
      );
    } finally {
      setStatusLoading(false);
    }
  };

  const primaryStatusAction = useMemo(() => {
    if (!activeRide) return null;

    if (activeRide.status === "scheduled") {
      return {
        label: "Start boarding",
        status: "boarding" as DriverRideStatus,
        icon: "people-outline" as const,
        color: "#D97706",
      };
    }

    if (["boarding", "delayed"].includes(activeRide.status)) {
      return {
        label: "Start trip",
        status: "active" as DriverRideStatus,
        icon: "navigate" as const,
        color: "#15803D",
      };
    }

    if (activeRide.status === "active") {
      return {
        label: "Complete trip",
        status: "completed" as DriverRideStatus,
        icon: "checkmark-circle-outline" as const,
        color: theme.primary[300],
      };
    }

    return null;
  }, [activeRide, theme.primary]);

  const openNavigation = async () => {
    if (!destination) {
      Alert.alert("Destination unavailable", "This ride has no destination coordinates.");
      return;
    }

    const latitude = destination.latitude;
    const longitude = destination.longitude;
    const label = encodeURIComponent(destination.label);
    const nativeUrl =
      Platform.OS === "ios"
        ? `maps://?daddr=${latitude},${longitude}&q=${label}`
        : `google.navigation:q=${latitude},${longitude}&mode=d`;
    const fallbackUrl = `https://www.google.com/maps/dir/?api=1&destination=${latitude},${longitude}&travelmode=driving&dir_action=navigate&query=${label}`;

    try {
      const canOpenNative = await Linking.canOpenURL(nativeUrl);
      await Linking.openURL(canOpenNative ? nativeUrl : fallbackUrl);
    } catch {
      Alert.alert(
        "Navigation unavailable",
        "No supported navigation app could be opened.",
      );
    }
  };

  const callPassenger = async (phone: string) => {
    const normalizedPhone = phone.replace(/[^+\d]/g, "");

    if (!normalizedPhone) {
      Alert.alert("Phone unavailable", "This passenger has no valid phone number.");
      return;
    }

    try {
      await Linking.openURL(`tel:${normalizedPhone}`);
    } catch {
      Alert.alert("Call unavailable", "The phone dialler could not be opened.");
    }
  };

  const openRideDetails = () => {
    if (!activeRide) return;

    router.push(
      `/driver-ride-details?rideId=${encodeURIComponent(activeRide.$id)}` as never,
    );
  };

  const submitIncident = async () => {
    if (!activeRide || incidentSubmitting) return;

    if (incidentDescription.trim().length < 8) {
      Alert.alert(
        "Add more detail",
        "Describe what happened using at least 8 characters.",
      );
      return;
    }

    setIncidentSubmitting(true);

    try {
      await reportDriverIncident(activeRide.$id, {
        category: incidentCategory,
        description: incidentDescription.trim(),
        priority: incidentPriority,
        latitude: driverCoordinate?.latitude,
        longitude: driverCoordinate?.longitude,
      });

      setIncidentVisible(false);
      setIncidentDescription("");
      setIncidentCategory("breakdown");
      setIncidentPriority("medium");

      Alert.alert(
        "Incident reported",
        "The organization has received the incident report.",
      );
    } catch (caughtError) {
      Alert.alert(
        "Report failed",
        caughtError instanceof Error
          ? caughtError.message
          : "Please try again.",
      );
    } finally {
      setIncidentSubmitting(false);
    }
  };

  const refresh = () => {
    setRefreshing(true);
    void loadDashboard(false);
  };

  if (loading) {
    return (
      <View
        className="flex-1 items-center justify-center"
        style={{ backgroundColor: theme.background }}
      >
        <ActivityIndicator size="large" color={theme.primary[300]} />
      </View>
    );
  }

  return (
    <SafeAreaView
      edges={["top"]}
      className="flex-1"
      style={{ backgroundColor: theme.background }}
    >
      <ScrollView
        showsVerticalScrollIndicator={false}
        refreshControl={
          <RefreshControl
            refreshing={refreshing}
            onRefresh={refresh}
            tintColor={theme.primary[300]}
          />
        }
        contentContainerStyle={{
          paddingHorizontal: 18,
          paddingTop: 12,
          paddingBottom: bottomClearance,
        }}
      >
        <View className="flex-row items-start justify-between">
          <View className="flex-1 pr-4">
            <Text
              className="text-3xl font-rubik-bold"
              style={{ color: theme.title }}
            >
              Active ride
            </Text>
            <Text className="mt-1 text-sm" style={{ color: theme.muted }}>
              Navigate, track passengers, and control the trip.
            </Text>
          </View>

          <TouchableOpacity
            onPress={refresh}
            disabled={refreshing}
            className="h-11 w-11 items-center justify-center rounded-full"
            style={{ backgroundColor: theme.surface }}
          >
            {refreshing ? (
              <ActivityIndicator size="small" color={theme.primary[300]} />
            ) : (
              <Ionicons name="refresh" size={21} color={theme.text} />
            )}
          </TouchableOpacity>
        </View>

        {!isConnected && (
          <View
            className="mt-5 flex-row items-center rounded-2xl border px-4 py-3"
            style={{
              backgroundColor: "#FFF7ED",
              borderColor: "#FDBA7445",
            }}
          >
            <Ionicons name="cloud-offline-outline" size={22} color="#C2410C" />
            <Text className="ml-3 flex-1 text-sm" style={{ color: "#9A3412" }}>
              You are offline. The map may be limited and location publishing will retry.
            </Text>
          </View>
        )}

        {!activeRide ? (
          <View
            className="mt-8 items-center rounded-3xl border border-dashed p-8"
            style={{
              backgroundColor: theme.surface,
              borderColor: `${theme.muted}40`,
            }}
          >
            <Ionicons
              name="navigate-circle-outline"
              size={54}
              color={theme.muted}
            />
            <Text
              className="mt-4 text-lg font-rubik-bold"
              style={{ color: theme.title }}
            >
              No active assignment
            </Text>
            <Text
              className="mt-2 text-center text-sm leading-5"
              style={{ color: theme.muted }}
            >
              Open your assigned rides and start boarding when passengers are ready.
            </Text>
            <TouchableOpacity
              onPress={() => router.push("/driver-rides")}
              className="mt-6 rounded-full px-6 py-3.5"
              style={{ backgroundColor: theme.primary[300] }}
            >
              <Text className="font-rubik-bold text-white">
                View assigned rides
              </Text>
            </TouchableOpacity>
          </View>
        ) : (
          <>
            <View
              className="mt-6 overflow-hidden rounded-3xl border"
              style={{
                backgroundColor: theme.surface,
                borderColor: `${theme.muted}25`,
              }}
            >
              <View className="h-[310px] w-full">
                {mapError ? (
                  <View className="flex-1 items-center justify-center px-8">
                    <Ionicons name="map-outline" size={46} color={theme.muted} />
                    <Text
                      className="mt-3 text-center font-rubik-bold"
                      style={{ color: theme.title }}
                    >
                      Map unavailable
                    </Text>
                    <Text
                      className="mt-1 text-center text-sm"
                      style={{ color: theme.muted }}
                    >
                      {mapError}
                    </Text>
                  </View>
                ) : (
                  <WebView
                    ref={mapWebView}
                    source={{ html: mapHtml }}
                    originWhitelist={["*"]}
                    javaScriptEnabled
                    domStorageEnabled
                    mixedContentMode="always"
                    setSupportMultipleWindows={false}
                    onMessage={(event) => {
                      if (event.nativeEvent.data === "map-ready") {
                        setMapReady(true);
                        setMapError("");
                      }
                    }}
                    onError={() => {
                      setMapError(
                        "OpenStreetMap could not load. Check the internet connection and refresh.",
                      );
                    }}
                    style={{ flex: 1, backgroundColor: theme.surface }}
                  />
                )}

                {!mapReady && !mapError && (
                  <View
                    pointerEvents="none"
                    className="absolute inset-0 items-center justify-center"
                    style={{ backgroundColor: theme.surface }}
                  >
                    <ActivityIndicator size="large" color={theme.primary[300]} />
                    <Text className="mt-3 text-sm" style={{ color: theme.muted }}>
                      Loading live route…
                    </Text>
                  </View>
                )}

                {mapReady && driverCoordinate && (
                  <TouchableOpacity
                    onPress={() => {
                      mapWebView.current?.injectJavaScript(
                        "window.focusDriver(); true;",
                      );
                    }}
                    className="absolute bottom-4 right-4 h-11 w-11 items-center justify-center rounded-full"
                    style={{
                      backgroundColor: theme.surface,
                      shadowColor: "#000000",
                      shadowOpacity: 0.18,
                      shadowRadius: 8,
                      elevation: 5,
                    }}
                  >
                    <Ionicons
                      name="locate"
                      size={22}
                      color={theme.primary[300]}
                    />
                  </TouchableOpacity>
                )}
              </View>

              <View className="p-5">
                <View className="flex-row items-start justify-between">
                  <View className="flex-1 pr-4">
                    <Text
                      className="text-xl font-rubik-bold"
                      style={{ color: theme.title }}
                    >
                      {activeRide.route?.name ||
                        `${activeRide.vehicleMake} ${activeRide.vehicleModel}`}
                    </Text>
                    <Text className="mt-1 text-sm" style={{ color: theme.muted }}>
                      {activeRide.route
                        ? `${activeRide.route.originName} → ${activeRide.route.destinationName}`
                        : activeRide.schoolLocation}
                    </Text>
                  </View>

                  <View
                    className="rounded-full px-3 py-1.5"
                    style={{ backgroundColor: `${theme.primary[300]}15` }}
                  >
                    <Text
                      className="text-xs font-rubik-bold"
                      style={{ color: theme.primary[300] }}
                    >
                      {formatDriverRideStatus(activeRide.status)}
                    </Text>
                  </View>
                </View>

                <View className="mt-5 flex-row gap-3">
                  <View
                    className="flex-1 rounded-2xl p-3"
                    style={{ backgroundColor: `${theme.muted}0D` }}
                  >
                    <Text className="text-xs" style={{ color: theme.muted }}>
                      Remaining
                    </Text>
                    <Text
                      className="mt-1 font-rubik-bold"
                      style={{ color: theme.title }}
                    >
                      {remainingDistanceKm === null
                        ? "—"
                        : `${remainingDistanceKm.toFixed(1)} km`}
                    </Text>
                  </View>

                  <View
                    className="flex-1 rounded-2xl p-3"
                    style={{ backgroundColor: `${theme.muted}0D` }}
                  >
                    <Text className="text-xs" style={{ color: theme.muted }}>
                      Approx. ETA
                    </Text>
                    <Text
                      className="mt-1 font-rubik-bold"
                      style={{ color: theme.title }}
                    >
                      {remainingMinutes === null ? "—" : `${remainingMinutes} min`}
                    </Text>
                  </View>

                  <View
                    className="flex-1 rounded-2xl p-3"
                    style={{ backgroundColor: `${theme.muted}0D` }}
                  >
                    <Text className="text-xs" style={{ color: theme.muted }}>
                      Passengers
                    </Text>
                    <Text
                      className="mt-1 font-rubik-bold"
                      style={{ color: theme.title }}
                    >
                      {activeRide.bookedSeats}/{activeRide.totalSeats}
                    </Text>
                  </View>
                </View>

                <TouchableOpacity
                  onPress={() => void openNavigation()}
                  className="mt-4 flex-row items-center justify-center rounded-2xl py-3.5"
                  style={{ backgroundColor: theme.primary[300] }}
                >
                  <Ionicons name="navigate" size={20} color="#FFFFFF" />
                  <Text className="ml-2 font-rubik-bold text-white">
                    Open navigation
                  </Text>
                </TouchableOpacity>
              </View>
            </View>

            <View
              className="mt-5 rounded-3xl border p-5"
              style={{
                backgroundColor: sharingLocation ? "#ECFDF5" : theme.surface,
                borderColor: sharingLocation ? "#22C55E45" : `${theme.muted}25`,
              }}
            >
              <View className="flex-row items-center">
                <View
                  className="h-11 w-11 items-center justify-center rounded-full"
                  style={{
                    backgroundColor: sharingLocation
                      ? "#DCFCE7"
                      : `${theme.muted}12`,
                  }}
                >
                  <Ionicons
                    name={sharingLocation ? "radio" : "radio-outline"}
                    size={23}
                    color={sharingLocation ? "#15803D" : theme.muted}
                  />
                </View>

                <View className="ml-3 flex-1">
                  <Text
                    className="font-rubik-bold"
                    style={{ color: theme.title }}
                  >
                    Live location
                  </Text>
                  <Text className="mt-1 text-xs" style={{ color: theme.muted }}>
                    {sharingLocation
                      ? formatLocationAge(lastLocationAt)
                      : locationPermission === "denied"
                        ? "Location permission is not enabled"
                        : "Location sharing is off"}
                  </Text>
                </View>

                {driverCoordinate?.speedKph !== null &&
                  driverCoordinate?.speedKph !== undefined && (
                    <View className="items-end">
                      <Text
                        className="font-rubik-bold"
                        style={{ color: theme.title }}
                      >
                        {Math.max(0, Math.round(driverCoordinate.speedKph))}
                      </Text>
                      <Text className="text-[10px]" style={{ color: theme.muted }}>
                        km/h
                      </Text>
                    </View>
                  )}
              </View>

              {!!locationMessage && (
                <Text className="mt-3 text-xs leading-5" style={{ color: "#B45309" }}>
                  {locationMessage}
                </Text>
              )}

              <TouchableOpacity
                onPress={
                  sharingLocation
                    ? stopLocationSharing
                    : () => void startLocationSharing()
                }
                className="mt-4 rounded-2xl py-3.5"
                style={{
                  backgroundColor: sharingLocation ? "#DC2626" : "#15803D",
                }}
              >
                <Text className="text-center font-rubik-bold text-white">
                  {sharingLocation ? "Stop sharing" : "Start sharing location"}
                </Text>
              </TouchableOpacity>
            </View>

            <View className="mt-7 flex-row items-center justify-between">
              <Text
                className="text-xl font-rubik-bold"
                style={{ color: theme.title }}
              >
                Passengers
              </Text>
              <TouchableOpacity onPress={openRideDetails}>
                <Text
                  className="font-rubik-bold"
                  style={{ color: theme.primary[300] }}
                >
                  View all
                </Text>
              </TouchableOpacity>
            </View>

            {(rideDetails?.bookings ?? []).length === 0 ? (
              <View
                className="mt-3 rounded-2xl border border-dashed p-5"
                style={{ borderColor: `${theme.muted}35` }}
              >
                <Text className="text-center text-sm" style={{ color: theme.muted }}>
                  No passenger bookings are attached to this ride yet.
                </Text>
              </View>
            ) : (
              (rideDetails?.bookings ?? []).slice(0, 3).map((booking) => (
                <View
                  key={booking.$id}
                  className="mt-3 flex-row items-center rounded-2xl border p-4"
                  style={{
                    backgroundColor: theme.surface,
                    borderColor: `${theme.muted}25`,
                  }}
                >
                  <View
                    className="h-11 w-11 items-center justify-center rounded-full"
                    style={{ backgroundColor: `${theme.primary[300]}12` }}
                  >
                    <Ionicons
                      name="person"
                      size={20}
                      color={theme.primary[300]}
                    />
                  </View>

                  <View className="ml-3 flex-1">
                    <Text
                      className="font-rubik-bold"
                      style={{ color: theme.title }}
                    >
                      {booking.studentName}
                    </Text>
                    <Text className="mt-1 text-xs" style={{ color: theme.muted }}>
                      {booking.seatCount} seat{booking.seatCount === 1 ? "" : "s"} · {booking.status}
                    </Text>
                  </View>

                  <TouchableOpacity
                    onPress={() => void callPassenger(booking.studentPhone)}
                    className="h-10 w-10 items-center justify-center rounded-full"
                    style={{ backgroundColor: "#DCFCE7" }}
                  >
                    <Ionicons name="call" size={18} color="#15803D" />
                  </TouchableOpacity>
                </View>
              ))
            )}

            <Text
              className="mb-3 mt-7 text-xl font-rubik-bold"
              style={{ color: theme.title }}
            >
              Trip controls
            </Text>

            <View
              className="rounded-3xl border p-5"
              style={{
                backgroundColor: theme.surface,
                borderColor: `${theme.muted}25`,
              }}
            >
              <View className="flex-row items-center justify-between">
                <View>
                  <Text className="text-xs" style={{ color: theme.muted }}>
                    Current status
                  </Text>
                  <Text
                    className="mt-1 font-rubik-bold"
                    style={{ color: theme.title }}
                  >
                    {formatDriverRideStatus(activeRide.status)}
                  </Text>
                </View>

                <Text className="text-xs" style={{ color: theme.muted }}>
                  {activeRide.vehicleRegistration}
                </Text>
              </View>

              {primaryStatusAction && (
                <TouchableOpacity
                  onPress={() => void changeStatus(primaryStatusAction.status)}
                  disabled={statusLoading}
                  className="mt-5 flex-row items-center justify-center rounded-2xl py-4"
                  style={{
                    backgroundColor: primaryStatusAction.color,
                    opacity: statusLoading ? 0.65 : 1,
                  }}
                >
                  {statusLoading ? (
                    <ActivityIndicator color="#FFFFFF" />
                  ) : (
                    <>
                      <Ionicons
                        name={primaryStatusAction.icon}
                        size={21}
                        color="#FFFFFF"
                      />
                      <Text className="ml-2 font-rubik-bold text-white">
                        {primaryStatusAction.label}
                      </Text>
                    </>
                  )}
                </TouchableOpacity>
              )}

              {["scheduled", "boarding", "active"].includes(
                activeRide.status,
              ) && (
                <TouchableOpacity
                  onPress={() => void changeStatus("delayed")}
                  disabled={statusLoading}
                  className="mt-3 rounded-2xl border py-3.5"
                  style={{
                    borderColor: "#D97706",
                    backgroundColor: "#FFF7ED",
                    opacity: statusLoading ? 0.65 : 1,
                  }}
                >
                  <Text
                    className="text-center font-rubik-bold"
                    style={{ color: "#B45309" }}
                  >
                    Mark as delayed
                  </Text>
                </TouchableOpacity>
              )}

              <TouchableOpacity
                onPress={() => setIncidentVisible(true)}
                disabled={incidentSubmitting}
                className="mt-3 flex-row items-center justify-center rounded-2xl border py-3.5"
                style={{
                  borderColor: theme.danger,
                  backgroundColor: `${theme.danger}08`,
                }}
              >
                <Ionicons name="warning-outline" size={20} color={theme.danger} />
                <Text
                  className="ml-2 font-rubik-bold"
                  style={{ color: theme.danger }}
                >
                  Report incident
                </Text>
              </TouchableOpacity>
            </View>
          </>
        )}
      </ScrollView>

      <Modal
        visible={incidentVisible}
        transparent
        animationType="slide"
        onRequestClose={() => {
          if (!incidentSubmitting) setIncidentVisible(false);
        }}
      >
        <KeyboardAvoidingView
          behavior={Platform.OS === "ios" ? "padding" : undefined}
          className="flex-1 justify-end"
          style={{ backgroundColor: "rgba(0,0,0,0.45)" }}
        >
          <SafeAreaView
            edges={["bottom"]}
            className="max-h-[88%] rounded-t-[30px]"
            style={{ backgroundColor: theme.background }}
          >
            <ScrollView
              keyboardShouldPersistTaps="handled"
              contentContainerStyle={{ padding: 20, paddingBottom: 28 }}
            >
              <View className="flex-row items-center justify-between">
                <View>
                  <Text
                    className="text-2xl font-rubik-bold"
                    style={{ color: theme.title }}
                  >
                    Report incident
                  </Text>
                  <Text className="mt-1 text-sm" style={{ color: theme.muted }}>
                    Send the organization clear safety details.
                  </Text>
                </View>

                <TouchableOpacity
                  onPress={() => setIncidentVisible(false)}
                  disabled={incidentSubmitting}
                  className="h-10 w-10 items-center justify-center rounded-full"
                  style={{ backgroundColor: theme.surface }}
                >
                  <Ionicons name="close" size={23} color={theme.text} />
                </TouchableOpacity>
              </View>

              <Text
                className="mb-3 mt-6 font-rubik-bold"
                style={{ color: theme.title }}
              >
                Category
              </Text>

              <View className="flex-row flex-wrap gap-2">
                {INCIDENT_CATEGORIES.map((category) => {
                  const selected = incidentCategory === category.value;

                  return (
                    <TouchableOpacity
                      key={category.value}
                      onPress={() => setIncidentCategory(category.value)}
                      className="flex-row items-center rounded-full border px-4 py-2.5"
                      style={{
                        backgroundColor: selected
                          ? `${theme.primary[300]}14`
                          : theme.surface,
                        borderColor: selected
                          ? theme.primary[300]
                          : `${theme.muted}30`,
                      }}
                    >
                      <Ionicons
                        name={category.icon}
                        size={17}
                        color={selected ? theme.primary[300] : theme.muted}
                      />
                      <Text
                        className="ml-2 font-rubik-medium"
                        style={{
                          color: selected ? theme.primary[300] : theme.text,
                        }}
                      >
                        {category.label}
                      </Text>
                    </TouchableOpacity>
                  );
                })}
              </View>

              <Text
                className="mb-3 mt-6 font-rubik-bold"
                style={{ color: theme.title }}
              >
                Priority
              </Text>

              <View className="flex-row gap-2">
                {INCIDENT_PRIORITIES.map((priority) => {
                  const selected = incidentPriority === priority;

                  return (
                    <TouchableOpacity
                      key={priority}
                      onPress={() => setIncidentPriority(priority)}
                      className="flex-1 rounded-xl border py-3"
                      style={{
                        backgroundColor: selected
                          ? priority === "critical"
                            ? "#FEE2E2"
                            : `${theme.primary[300]}12`
                          : theme.surface,
                        borderColor: selected
                          ? priority === "critical"
                            ? "#DC2626"
                            : theme.primary[300]
                          : `${theme.muted}30`,
                      }}
                    >
                      <Text
                        className="text-center text-xs font-rubik-bold capitalize"
                        style={{
                          color: selected
                            ? priority === "critical"
                              ? "#B91C1C"
                              : theme.primary[300]
                            : theme.muted,
                        }}
                      >
                        {priority}
                      </Text>
                    </TouchableOpacity>
                  );
                })}
              </View>

              <Text
                className="mb-3 mt-6 font-rubik-bold"
                style={{ color: theme.title }}
              >
                What happened?
              </Text>

              <TextInput
                value={incidentDescription}
                onChangeText={setIncidentDescription}
                placeholder="Describe the incident, people involved, and help needed…"
                placeholderTextColor={theme.muted}
                multiline
                textAlignVertical="top"
                maxLength={700}
                className="min-h-[140px] rounded-2xl border p-4"
                style={{
                  color: theme.text,
                  backgroundColor: theme.surface,
                  borderColor: `${theme.muted}30`,
                }}
              />

              <Text className="mt-2 text-right text-xs" style={{ color: theme.muted }}>
                {incidentDescription.length}/700
              </Text>

              <TouchableOpacity
                onPress={() => void submitIncident()}
                disabled={incidentSubmitting}
                className="mt-5 flex-row items-center justify-center rounded-2xl py-4"
                style={{
                  backgroundColor: theme.danger,
                  opacity: incidentSubmitting ? 0.65 : 1,
                }}
              >
                {incidentSubmitting ? (
                  <ActivityIndicator color="#FFFFFF" />
                ) : (
                  <>
                    <Ionicons name="send" size={19} color="#FFFFFF" />
                    <Text className="ml-2 font-rubik-bold text-white">
                      Submit incident
                    </Text>
                  </>
                )}
              </TouchableOpacity>
            </ScrollView>
          </SafeAreaView>
        </KeyboardAvoidingView>
      </Modal>
    </SafeAreaView>
  );
}
