export default function DriverRidesScreen() {
  const colorScheme = useColorScheme();
  const theme = Colors[colorScheme ?? "light"];
  const accountId = useAuthStore(
    (state) => state.user?.accountId || "",
  );

  const memorySnapshot =
    peekProfilePageCache<DriverRidesSnapshot>(
      accountId,
      DRIVER_RIDES_CACHE_KEY,
    );

  const [section, setSection] =
    useState<DriverRidesSection>(
      () => memorySnapshot?.section ?? "requests",
    );
  const [offerFilter, setOfferFilter] =
    useState<DriverOfferFilter>(
      () => memorySnapshot?.offerFilter ?? "awaiting",
    );
  const [requests, setRequests] = useState<RideRequest[]>(
    () => memorySnapshot?.requests ?? [],
  );
  const [offers, setOffers] = useState<RideOffer[]>(
    () => memorySnapshot?.offers ?? [],
  );
  const [trips, setTrips] = useState<DriverRide[]>(
    () => memorySnapshot?.trips ?? [],
  );
  const [loading, setLoading] = useState(
    () => !memorySnapshot,
  );
  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState(
    () => memorySnapshot?.error ?? "",
  );
  const [lastUpdatedAt, setLastUpdatedAt] = useState(
    () => memorySnapshot?.lastUpdatedAt ?? 0,
  );

  const snapshotRef = useRef<DriverRidesSnapshot>(
    memorySnapshot ?? EMPTY_SNAPSHOT,
  );
  const networkLoadFinishedRef = useRef(false);
  const loadPromiseRef = useRef<Promise<void> | null>(null);

  const applySnapshot = useCallback(
    (snapshot: DriverRidesSnapshot) => {
      snapshotRef.current = snapshot;
      setSection(snapshot.section);
      setOfferFilter(snapshot.offerFilter);
      setRequests(snapshot.requests);
      setOffers(snapshot.offers);
      setTrips(snapshot.trips);
      setError(snapshot.error);
      setLastUpdatedAt(snapshot.lastUpdatedAt);
    },
    [],
  );

  const persistSnapshot = useCallback(
    async (snapshot: DriverRidesSnapshot) => {
      snapshotRef.current = snapshot;

      if (!accountId) return;

      await writeProfilePageCache(
        accountId,
        DRIVER_RIDES_CACHE_KEY,
        snapshot,
      );
    },
    [accountId],
  );

  useEffect(() => {
    let active = true;

    if (!accountId) {
      return () => {
        active = false;
      };
    }

    void readProfilePageCache<DriverRidesSnapshot>(
      accountId,
      DRIVER_RIDES_CACHE_KEY,
    ).then((snapshot) => {
      if (
        !active ||
        !snapshot ||
        networkLoadFinishedRef.current
      ) {
        return;
      }

      applySnapshot(snapshot);
      setLoading(false);
    });

    return () => {
      active = false;
    };
  }, [accountId, applySnapshot]);

  const loadMarketplace = useCallback(
    async (refresh = false) => {
      if (loadPromiseRef.current) {
        if (refresh) {
          setRefreshing(true);
        }

        await loadPromiseRef.current;

        if (refresh) {
          setRefreshing(false);
        }

        return;
      }

      const current = snapshotRef.current;
      const hasCachedData =
        current.requests.length > 0 ||
        current.offers.length > 0 ||
        current.trips.length > 0;

      if (refresh) {
        setRefreshing(true);
      } else if (!hasCachedData) {
        setLoading(true);
      }

      const run = (async () => {
        const results = await Promise.allSettled([
          getDriverOpenRideRequests(),
          getDriverRideOffers(),
          getDriverRides(),
        ]);

        const [
          requestResult,
          offerResult,
          tripResult,
        ] = results;

        const messages: string[] = [];
        let anySuccess = false;
        let nextRequests = current.requests;
        let nextOffers = current.offers;
        let nextTrips = current.trips;

        if (requestResult.status === "fulfilled") {
          nextRequests = [...requestResult.value].sort(
            (left, right) =>
              new Date(
                left.requestedDepartureTime,
              ).getTime() -
              new Date(
                right.requestedDepartureTime,
              ).getTime(),
          );
          anySuccess = true;
        } else {
          messages.push(
            requestResult.reason instanceof Error
              ? requestResult.reason.message
              : "Could not load student requests.",
          );
        }

        if (offerResult.status === "fulfilled") {
          nextOffers = [...offerResult.value].sort(
            (left, right) =>
              new Date(right.createdAt).getTime() -
              new Date(left.createdAt).getTime(),
          );
          anySuccess = true;
        } else {
          messages.push(
            offerResult.reason instanceof Error
              ? offerResult.reason.message
              : "Could not load your offers.",
          );
        }

        if (tripResult.status === "fulfilled") {
          nextTrips = [...tripResult.value].sort(
            (left, right) =>
              new Date(left.departureTime).getTime() -
              new Date(right.departureTime).getTime(),
          );
          anySuccess = true;
        } else {
          messages.push(
            tripResult.reason instanceof Error
              ? tripResult.reason.message
              : "Could not load confirmed trips.",
          );
        }

        const nextError = Array.from(
          new Set(messages),
        ).join(" ");
        const nextUpdatedAt = anySuccess
          ? Date.now()
          : current.lastUpdatedAt;
        const nextSnapshot: DriverRidesSnapshot = {
          ...snapshotRef.current,
          requests: nextRequests,
          offers: nextOffers,
          trips: nextTrips,
          error: nextError,
          lastUpdatedAt: nextUpdatedAt,
        };

        if (anySuccess) {
          networkLoadFinishedRef.current = true;
        }

        snapshotRef.current = nextSnapshot;
        setRequests(nextRequests);
        setOffers(nextOffers);
        setTrips(nextTrips);
        setError(nextError);
        setLastUpdatedAt(nextUpdatedAt);

        await persistSnapshot(nextSnapshot);
      })();

      loadPromiseRef.current = run;

      try {
        await run;
      } finally {
        loadPromiseRef.current = null;
        setLoading(false);
        setRefreshing(false);
      }
    },
    [persistSnapshot],
  );

  useFocusEffect(
    useCallback(() => {
      void loadMarketplace(false);

      const unsubscribe =
        subscribeToDriverRealtimeRefresh(() => {
          void loadMarketplace(false);
        });

      return unsubscribe;
    }, [loadMarketplace]),
  );

  const selectSection = useCallback(
    (nextSection: DriverRidesSection) => {
      setSection(nextSection);

      const nextSnapshot = {
        ...snapshotRef.current,
        section: nextSection,
      };

      void persistSnapshot(nextSnapshot);
    },
    [persistSnapshot],
  );

  const selectOfferFilter = useCallback(
    (nextFilter: DriverOfferFilter) => {
      setOfferFilter(nextFilter);

      const nextSnapshot = {
        ...snapshotRef.current,
        offerFilter: nextFilter,
      };

      void persistSnapshot(nextSnapshot);
    },
    [persistSnapshot],
  );

  const awaitingOffers = useMemo(
    () =>
      offers.filter(
        (offer) =>
          normalizeStatus(offer.status) === "submitted",
      ),
    [offers],
  );

  const acceptedOffers = useMemo(
    () =>
      offers.filter(
        (offer) =>
          normalizeStatus(offer.status) === "accepted",
      ),
    [offers],
  );

  const closedOffers = useMemo(
    () =>
      offers.filter((offer) =>
        ["declined", "withdrawn", "expired"].includes(
          normalizeStatus(offer.status),
        ),
      ),
    [offers],
  );

  const visibleOffers = useMemo(
    () =>
      offers.filter((offer) =>
        offerMatchesFilter(offer, offerFilter),
      ),
    [offerFilter, offers],
  );

  const confirmedTrips = useMemo(
    () =>
      trips
        .filter(isConfirmedTrip)
        .sort(
          (left, right) =>
            new Date(left.departureTime).getTime() -
            new Date(right.departureTime).getTime(),
        ),
    [trips],
  );

  const historyTrips = useMemo(
    () =>
      trips
        .filter((ride) => !isConfirmedTrip(ride))
        .sort(
          (left, right) =>
            new Date(right.departureTime).getTime() -
            new Date(left.departureTime).getTime(),
        ),
    [trips],
  );

  const activeTripCount = useMemo(
    () => confirmedTrips.filter(isLiveTrip).length,
    [confirmedTrips],
  );

  const sectionCount = useMemo(
    () => ({
      requests: requests.length,
      offers: offers.length,
      confirmed: confirmedTrips.length,
      history: historyTrips.length,
    }),
    [
      confirmedTrips.length,
      historyTrips.length,
      offers.length,
      requests.length,
    ],
  );

  const suspensionError = error
    .toLowerCase()
    .includes("suspend");

  const openRequest = useCallback(
    (requestId: string) => {
      router.push({
        pathname:
          "/rides/driver-request/[requestId]" as any,
        params: { requestId },
      });
    },
    [],
  );

  const openTrip = useCallback((ride: DriverRide) => {
    if (isLiveTrip(ride)) {
      router.push("/driver-active" as any);
      return;
    }

    if (!String(ride.routeId || "").trim()) {
      Alert.alert(
        "Direct student ride",
        normalizeStatus(ride.status) === "scheduled"
          ? "This ride is confirmed. It will appear in Active Ride when boarding begins."
          : "This direct ride is saved in your trip history.",
      );
      return;
    }

    router.push({
      pathname: "/driver-ride-details",
      params: { rideId: ride.$id },
    });
  }, []);

  const renderSectionButtons = () => {
    const items = [
      {
        value: "requests" as const,
        label: "Requests",
        icon: "navigate-outline" as const,
      },
      {
        value: "offers" as const,
        label: "Offers",
        icon: "pricetags-outline" as const,
      },
      {
        value: "confirmed" as const,
        label: "Confirmed",
        icon: "checkmark-circle-outline" as const,
      },
      {
        value: "history" as const,
        label: "History",
        icon: "time-outline" as const,
      },
    ];

    return (
      <ScrollView
        horizontal
        showsHorizontalScrollIndicator={false}
        contentContainerStyle={{
          paddingHorizontal: 20,
          paddingVertical: 4,
        }}
        style={{ flexGrow: 0 }}
      >
        {items.map((item) => {
          const selected = section === item.value;

          return (
            <TouchableOpacity
              key={item.value}
              onPress={() => selectSection(item.value)}
              className="mr-2 min-w-[108px] rounded-2xl border px-3 py-3"
              style={{
                backgroundColor: selected
                  ? theme.primary[300]
                  : theme.surface,
                borderColor: selected
                  ? theme.primary[300]
                  : `${theme.muted}20`,
              }}
            >
              <View className="flex-row items-center justify-center">
                <Ionicons
                  name={item.icon}
                  size={17}
                  color={
                    selected ? "#FFFFFF" : theme.muted
                  }
                />
                <Text
                  className="ml-1.5 text-xs font-rubik-bold"
                  style={{
                    color: selected
                      ? "#FFFFFF"
                      : theme.text,
                  }}
                >
                  {item.label}
                </Text>
              </View>
              <Text
                className="mt-1 text-center text-[11px] font-rubik"
                style={{
                  color: selected
                    ? "#FFFFFFCC"
                    : theme.muted,
                }}
              >
                {sectionCount[item.value]}
              </Text>
            </TouchableOpacity>
          );
        })}
      </ScrollView>
    );
  };

  const renderOfferFilters = () => {
    const items = [
      {
        value: "awaiting" as const,
        label: "Awaiting",
        count: awaitingOffers.length,
      },
      {
        value: "accepted" as const,
        label: "Accepted",
        count: acceptedOffers.length,
      },
      {
        value: "closed" as const,
        label: "Closed",
        count: closedOffers.length,
      },
    ];

    return (
      <View className="mx-5 mb-3 mt-3 flex-row rounded-2xl p-1"
        style={{ backgroundColor: theme.surface }}
      >
        {items.map((item) => {
          const selected = offerFilter === item.value;

          return (
            <TouchableOpacity
              key={item.value}
              onPress={() =>
                selectOfferFilter(item.value)
              }
              className="flex-1 rounded-xl px-2 py-2.5"
              style={{
                backgroundColor: selected
                  ? `${theme.primary[300]}14`
                  : "transparent",
              }}
            >
              <Text
                className="text-center text-xs font-rubik-bold"
                style={{
                  color: selected
                    ? theme.primary[300]
                    : theme.muted,
                }}
              >
                {item.label} · {item.count}
              </Text>
            </TouchableOpacity>
          );
        })}
      </View>
    );
  };

  const renderEmpty = () => {
    const content = {
      requests: {
        icon: "navigate-outline" as const,
        title: "No open requests",
        message:
          "New ride requests from your recognised institutions will appear here in real time.",
      },
      offers: {
        icon: "pricetags-outline" as const,
        title:
          offerFilter === "awaiting"
            ? "No offers awaiting a response"
            : offerFilter === "accepted"
              ? "No accepted offers"
              : "No closed offers",
        message:
          offerFilter === "awaiting"
            ? "Open a request and submit your fare, pickup time and journey estimate."
            : offerFilter === "accepted"
              ? "Accepted offers become confirmed trips."
              : "Declined, withdrawn and expired offers will appear here.",
      },
      confirmed: {
        icon: "checkmark-circle-outline" as const,
        title: "No confirmed trips",
        message:
          "Trips appear here immediately after a passenger accepts your offer.",
      },
      history: {
        icon: "time-outline" as const,
        title: "No trip history",
        message:
          "Completed and cancelled trips will be kept here.",
      },
    }[section];

    return (
      <View className="flex-1 items-center justify-center px-7 py-16">
        <View
          className="h-16 w-16 items-center justify-center rounded-full"
          style={{
            backgroundColor: `${theme.primary[300]}12`,
          }}
        >
          <Ionicons
            name={content.icon}
            size={31}
            color={theme.primary[300]}
          />
        </View>
        <Text
          className="mt-4 text-center text-lg font-rubik-bold"
          style={{ color: theme.title }}
        >
          {content.title}
        </Text>
        <Text
          className="mt-2 text-center text-sm font-rubik"
          style={{ color: theme.muted }}
        >
          {content.message}
        </Text>
      </View>
    );
  };

  const refreshControl = (
    <RefreshControl
      refreshing={refreshing}
      onRefresh={() => void loadMarketplace(true)}
      tintColor={theme.primary[300]}
    />
  );

  const showLoading =
    loading &&
    requests.length === 0 &&
    offers.length === 0 &&
    trips.length === 0;

  if (showLoading) {
    return (
      <View
        className="flex-1 items-center justify-center"
        style={{ backgroundColor: theme.background }}
      >
        <ActivityIndicator
          size="large"
          color={theme.primary[300]}
        />
        <Text
          className="mt-3 text-sm font-rubik"
          style={{ color: theme.muted }}
        >
          Loading Driver Rides...
        </Text>
      </View>
    );
  }

  return (
    <SafeAreaView
      className="flex-1"
      style={{ backgroundColor: theme.background }}
    >
      <View className="px-5 pb-3 pt-2">
        <View className="flex-row items-start justify-between">
          <View className="min-w-0 flex-1 pr-3">
            <Text
              className="text-3xl font-rubik-bold"
              style={{ color: theme.title }}
            >
              Driver Rides
            </Text>
            <Text
              className="mt-1 text-sm font-rubik"
              style={{ color: theme.muted }}
            >
              Quote requests, track accepted offers and run confirmed trips.
            </Text>
          </View>

          <TouchableOpacity
            onPress={() => void loadMarketplace(true)}
            disabled={refreshing}
            className="h-11 w-11 items-center justify-center rounded-2xl"
            style={{ backgroundColor: theme.surface }}
          >
            {refreshing ? (
              <ActivityIndicator
                size="small"
                color={theme.primary[300]}
              />
            ) : (
              <Ionicons
                name="refresh"
                size={20}
                color={theme.primary[300]}
              />
            )}
          </TouchableOpacity>
        </View>

        <View className="mt-3 flex-row items-center">
          <View
            className="mr-2 h-2 w-2 rounded-full"
            style={{
              backgroundColor: error
                ? "#D97706"
                : "#16824B",
            }}
          />
          <Text
            className="text-xs font-rubik"
            style={{ color: theme.muted }}
          >
            {formatLastUpdated(lastUpdatedAt)}
          </Text>
        </View>
      </View>

      <ScrollView
        horizontal
        showsHorizontalScrollIndicator={false}
        contentContainerStyle={{
          paddingHorizontal: 20,
          paddingVertical: 8,
        }}
        style={{ flexGrow: 0 }}
      >
        <StatCard
          icon="navigate-outline"
          label="Open requests"
          value={requests.length}
          theme={theme}
        />
        <StatCard
          icon="hourglass-outline"
          label="Awaiting offers"
          value={awaitingOffers.length}
          theme={theme}
        />
        <StatCard
          icon="radio-outline"
          label="Live trips"
          value={activeTripCount}
          theme={theme}
        />
      </ScrollView>

      {renderSectionButtons()}

      {section === "offers"
        ? renderOfferFilters()
        : null}

      {error ? (
        <TouchableOpacity
          onPress={
            suspensionError
              ? () =>
                  router.push(
                    "/driver-profile" as any,
                  )
              : () => void loadMarketplace(true)
          }
          className="mx-5 mb-3 flex-row items-center rounded-2xl border p-3"
          style={{
            backgroundColor: suspensionError
              ? "#FEF2F2"
              : "#FFF8E7",
            borderColor: suspensionError
              ? "#FCA5A5"
              : "#F4D79A",
          }}
        >
          <Ionicons
            name={
              suspensionError
                ? "ban-outline"
                : "warning-outline"
            }
            size={19}
            color={
              suspensionError
                ? "#DC2626"
                : "#A15C00"
            }
          />
          <Text
            className="ml-2 flex-1 text-xs font-rubik"
            style={{
              color: suspensionError
                ? "#7F1D1D"
                : "#7A4500",
            }}
          >
            {error}
          </Text>
          <Ionicons
            name={
              suspensionError
                ? "person-outline"
                : "refresh"
            }
            size={18}
            color={
              suspensionError
                ? "#DC2626"
                : "#A15C00"
            }
          />
        </TouchableOpacity>
      ) : null}

      {section === "requests" ? (
        <FlatList
          data={requests}
          keyExtractor={(item) => item.$id}
          renderItem={({ item }) => (
            <RequestCard
              request={item}
              onPress={() => openRequest(item.$id)}
              theme={theme}
            />
          )}
          contentContainerStyle={{
            paddingHorizontal: 20,
            paddingTop: 4,
            paddingBottom: 110,
            flexGrow:
              requests.length === 0 ? 1 : undefined,
          }}
          ListEmptyComponent={renderEmpty}
          refreshControl={refreshControl}
        />
      ) : section === "offers" ? (
        <FlatList
          data={visibleOffers}
          keyExtractor={(item) => item.$id}
          renderItem={({ item }) => (
            <OfferCard
              offer={item}
              onPress={() =>
                item.requestId
                  ? openRequest(item.requestId)
                  : undefined
              }
              theme={theme}
            />
          )}
          contentContainerStyle={{
            paddingHorizontal: 20,
            paddingTop: 4,
            paddingBottom: 110,
            flexGrow:
              visibleOffers.length === 0
                ? 1
                : undefined,
          }}
          ListEmptyComponent={renderEmpty}
          refreshControl={refreshControl}
        />
      ) : section === "confirmed" ? (
        <FlatList
          data={confirmedTrips}
          keyExtractor={(item) => item.$id}
          renderItem={({ item }) => (
            <TripCard
              ride={item}
              onPress={() => openTrip(item)}
              theme={theme}
            />
          )}
          contentContainerStyle={{
            paddingHorizontal: 20,
            paddingTop: 4,
            paddingBottom: 110,
            flexGrow:
              confirmedTrips.length === 0
                ? 1
                : undefined,
          }}
          ListEmptyComponent={renderEmpty}
          refreshControl={refreshControl}
        />
      ) : (
        <FlatList
          data={historyTrips}
          keyExtractor={(item) => item.$id}
          renderItem={({ item }) => (
            <TripCard
              ride={item}
              onPress={() => openTrip(item)}
              theme={theme}
            />
          )}
          contentContainerStyle={{
            paddingHorizontal: 20,
            paddingTop: 4,
            paddingBottom: 110,
            flexGrow:
              historyTrips.length === 0
                ? 1
                : undefined,
          }}
          ListEmptyComponent={renderEmpty}
          refreshControl={refreshControl}
        />
      )}
    </SafeAreaView>
  );
}
