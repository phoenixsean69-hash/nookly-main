} from "@/types/ride-marketplace";

type DriverRidesSection =
  | "requests"
  | "offers"
  | "confirmed"
  | "history";

type DriverOfferFilter =
  | "awaiting"
  | "accepted"
  | "closed";

interface DriverRidesSnapshot {
  section: DriverRidesSection;
  offerFilter: DriverOfferFilter;
  requests: RideRequest[];
  offers: RideOffer[];
  trips: DriverRide[];
  error: string;
  lastUpdatedAt: number;
}

const DRIVER_RIDES_CACHE_KEY = "driver-rides-marketplace";

const EMPTY_SNAPSHOT: DriverRidesSnapshot = {
  section: "requests",
  offerFilter: "awaiting",
  requests: [],
  offers: [],
  trips: [],
  error: "",
  lastUpdatedAt: 0,
};

const OFFER_STATUS_COLORS: Record<string, string> = {
  submitted: "#D97706",
  accepted: "#16824B",
  declined: "#DC2626",
  withdrawn: "#64748B",
  expired: "#64748B",
};

const RIDE_STATUS_COLORS: Record<string, string> = {
  scheduled: "#2563EB",
  boarding: "#D97706",
  active: "#16824B",
  delayed: "#DC2626",
  completed: "#64748B",
  cancelled: "#991B1B",
};

const normalizeStatus = (value?: string): string =>
  String(value || "")
    .trim()
    .toLowerCase();

const isConfirmedTrip = (ride: DriverRide): boolean =>
  ["scheduled", "boarding", "active", "delayed"].includes(
    normalizeStatus(ride.status),
  );

const isLiveTrip = (ride: DriverRide): boolean =>
  ["boarding", "active", "delayed"].includes(
    normalizeStatus(ride.status),
  );

const offerMatchesFilter = (
  offer: RideOffer,
  filter: DriverOfferFilter,
): boolean => {
  const status = normalizeStatus(offer.status);

  if (filter === "awaiting") {
    return status === "submitted";
  }

  if (filter === "accepted") {
    return status === "accepted";
  }

  return ["declined", "withdrawn", "expired"].includes(status);
};

const formatLastUpdated = (value: number): string => {
  if (!Number.isFinite(value) || value <= 0) {
    return "Not synced yet";
  }

  const elapsed = Date.now() - value;

  if (elapsed < 60_000) {
    return "Updated just now";
  }

  if (elapsed < 3_600_000) {
    const minutes = Math.max(1, Math.floor(elapsed / 60_000));
    return `Updated ${minutes} min ago`;
  }

  return new Date(value).toLocaleString("en-ZW", {
    day: "2-digit",
    month: "short",
    hour: "2-digit",
    minute: "2-digit",
  });
};

const getTripRouteLabel = (ride: DriverRide): string => {
  if (ride.route) {
    return `${ride.route.originName} → ${ride.route.destinationName}`;
  }

  return (
    ride.schoolLocation ||
    `${ride.vehicleMake} ${ride.vehicleModel}`
  );
};

