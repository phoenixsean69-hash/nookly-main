import { Colors } from "@/constants/Colors";
import { Ionicons } from "@expo/vector-icons";
import * as DocumentPicker from "expo-document-picker";
import React, { useEffect, useMemo, useState } from "react";
import {
  ActivityIndicator,
  Alert,
  Modal,
  Text,
  TextInput,
  TouchableOpacity,
  useColorScheme,
  View,
} from "react-native";

const MAX_LEASE_SIZE_BYTES = 10 * 1024 * 1024;

export interface SelectedLeaseFile {
  name: string;
  uri: string;
  mimeType: string;
  size: number;
}

interface LeaseDocumentModalProps {
  visible: boolean;
  onClose: () => void;
  onSubmit: (
    file: SelectedLeaseFile,
    message: string,
  ) => void | Promise<void>;
  propertyName: string;
  tenantName: string;
  isLoading?: boolean;
}

const formatFileSize = (bytes: number): string => {
  if (!bytes) return "Size unavailable";

  const megabytes = bytes / (1024 * 1024);

  return megabytes >= 1
    ? `${megabytes.toFixed(2)} MB`
    : `${(bytes / 1024).toFixed(1)} KB`;
};

export const LeaseDocumentModal = ({
  visible,
  onClose,
  onSubmit,
  propertyName,
  tenantName,
  isLoading = false,
}: LeaseDocumentModalProps) => {
  const colorScheme = useColorScheme();
  const theme = Colors[colorScheme ?? "light"];
  const [selectedFile, setSelectedFile] =
    useState<SelectedLeaseFile | null>(null);
  const [message, setMessage] = useState(
    "Please review this lease carefully before signing.",
  );
  const [pickingFile, setPickingFile] = useState(false);

  useEffect(() => {
    if (!visible) {
      setSelectedFile(null);
      setMessage(
        "Please review this lease carefully before signing.",
      );
      setPickingFile(false);
    }
  }, [visible]);

  const fileSummary = useMemo(() => {
    if (!selectedFile) return "";

    return `${formatFileSize(selectedFile.size)} · PDF`;
  }, [selectedFile]);

  const pickDocument = async () => {
    try {
      setPickingFile(true);

      const result = await DocumentPicker.getDocumentAsync({
        type: "application/pdf",
        copyToCacheDirectory: true,
        multiple: false,
      });

      if (
        result.canceled ||
        !result.assets ||
        result.assets.length === 0
      ) {
        return;
      }

      const asset = result.assets[0];
      const name = asset.name || "lease_document.pdf";
      const mimeType =
        asset.mimeType || "application/pdf";
      const size = asset.size || 0;

      const isPdf =
        mimeType === "application/pdf" ||
        name.toLowerCase().endsWith(".pdf");

      if (!isPdf) {
        Alert.alert(
          "PDF required",
          "Choose a PDF lease document.",
        );
        return;
      }

      if (size <= 0) {
        Alert.alert(
          "Invalid document",
          "The selected PDF is empty or its size could not be read.",
        );
        return;
      }

      if (size > MAX_LEASE_SIZE_BYTES) {
        Alert.alert(
          "Document too large",
          "Lease documents must be 10 MB or smaller.",
        );
        return;
      }

      setSelectedFile({
        name,
        uri: asset.uri,
        mimeType: "application/pdf",
        size,
      });
    } catch (error) {
      console.error("Error picking lease document:", error);
      Alert.alert(
        "Document error",
        "The PDF could not be selected.",
      );
    } finally {
      setPickingFile(false);
    }
  };

  const handleSubmit = async () => {
    if (!selectedFile) {
      Alert.alert(
        "Document required",
        "Select the lease PDF first.",
      );
      return;
    }

    await onSubmit(selectedFile, message.trim());
  };

  return (
    <Modal
      animationType="slide"
      transparent
      visible={visible}
      onRequestClose={onClose}
    >
      <View className="flex-1 justify-end bg-black/50">
        <View
          className="rounded-t-3xl p-6"
          style={{
            backgroundColor: theme.background,
            maxHeight: "86%",
          }}
        >
          <View className="flex-row items-center justify-between mb-4">
            <View className="flex-1 pr-4">
              <Text
                className="text-xl font-rubik-bold"
                style={{ color: theme.title }}
              >
                Send Lease Document
              </Text>
              <Text
                className="text-sm mt-1"
                style={{ color: theme.muted }}
              >
                {tenantName} · {propertyName}
              </Text>
            </View>

            <TouchableOpacity
              onPress={onClose}
              disabled={isLoading}
              className="p-2"
            >
              <Ionicons
                name="close"
                size={24}
                color={theme.text}
              />
            </TouchableOpacity>
          </View>

          <View
            className="rounded-2xl p-4 mb-4"
            style={{
              backgroundColor: theme.surface,
              borderWidth: 1,
              borderColor: theme.muted + "30",
            }}
          >
            <TouchableOpacity
              onPress={pickDocument}
              disabled={pickingFile || isLoading}
              className="py-7 px-3 items-center justify-center border-2 border-dashed rounded-xl"
              style={{
                borderColor: selectedFile
                  ? theme.primary[300]
                  : theme.muted + "50",
              }}
            >
              {pickingFile ? (
                <ActivityIndicator
                  size="small"
                  color={theme.primary[300]}
                />
              ) : (
                <>
                  <Ionicons
                    name={
                      selectedFile
                        ? "document-text"
                        : "cloud-upload-outline"
                    }
                    size={42}
                    color={
                      selectedFile
                        ? theme.primary[300]
                        : theme.muted
                    }
                  />

                  <Text
                    className="text-center font-rubik-medium mt-2"
                    style={{
                      color: selectedFile
                        ? theme.primary[300]
                        : theme.text,
                    }}
                    numberOfLines={2}
                  >
                    {selectedFile?.name ||
                      "Select lease PDF"}
                  </Text>

                  <Text
                    className="text-xs mt-1"
                    style={{ color: theme.muted }}
                  >
                    {selectedFile
                      ? `${fileSummary} · Tap to replace`
                      : "PDF only · Maximum 10 MB"}
                  </Text>
                </>
              )}
            </TouchableOpacity>
          </View>

          <Text
            className="font-rubik-medium mb-2"
            style={{ color: theme.text }}
          >
            Message to tenant
          </Text>

          <TextInput
            value={message}
            onChangeText={setMessage}
            editable={!isLoading}
            multiline
            maxLength={500}
            placeholder="Add instructions for the tenant..."
            placeholderTextColor={theme.muted}
            className="rounded-xl p-4 min-h-[100px] mb-2"
            style={{
              color: theme.text,
              backgroundColor: theme.surface,
              borderWidth: 1,
              borderColor: theme.muted + "35",
              textAlignVertical: "top",
            }}
          />

          <Text
            className="text-xs text-right mb-5"
            style={{ color: theme.muted }}
          >
            {message.length}/500
          </Text>

          <View className="flex-row gap-3">
            <TouchableOpacity
              onPress={onClose}
              disabled={isLoading}
              className="flex-1 py-3.5 rounded-xl border"
              style={{
                borderColor: theme.muted + "35",
                backgroundColor: theme.surface,
              }}
            >
              <Text
                className="text-center font-rubik-bold"
                style={{ color: theme.text }}
              >
                Cancel
              </Text>
            </TouchableOpacity>

            <TouchableOpacity
              onPress={handleSubmit}
              disabled={isLoading || !selectedFile}
              className="flex-1 py-3.5 rounded-xl flex-row items-center justify-center"
              style={{
                backgroundColor:
                  isLoading || !selectedFile
                    ? theme.muted
                    : theme.primary[300],
              }}
            >
              {isLoading ? (
                <ActivityIndicator
                  size="small"
                  color="#FFFFFF"
                />
              ) : (
                <Ionicons
                  name="send"
                  size={17}
                  color="#FFFFFF"
                />
              )}

              <Text className="text-white text-center font-rubik-bold ml-2">
                {isLoading ? "Sending..." : "Send Lease"}
              </Text>
            </TouchableOpacity>
          </View>
        </View>
      </View>
    </Modal>
  );
};
